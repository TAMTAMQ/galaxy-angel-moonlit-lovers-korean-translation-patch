{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "SCENARIO_DAT_00089800.txt",
    "encoding": "cp932",
    "sha256": "591aa88868789587f91ad5c39cb550b7275cf21e51e4303c969d79b615225bc2",
    "dialogue_count": 20
  },
  "units": [
    {
      "id": "SCENARIO_DAT_00089800:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "1,0010101"
      },
      "original": "フォルテ、戻ってる？\n",
      "translation": "포르테, 돌아왔어？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00089800:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "5,0050101",
        "voice": "GB450400,3"
      },
      "original": "ああ、いるよ。\nいま開ける。\n",
      "translation": "아아, 있어. 지금 열게.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00089800:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "5,0050101",
        "voice": "GB450401,3",
        "face": "0,0050102,0"
      },
      "original": "まぁ、ゆっくりしていきなよ。\n",
      "translation": "뭐, 천천히 쉬다 가.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00089800:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "voice": "GB450401,3",
        "face": "0,0050102,0"
      },
      "original": "ああ。\nフォルテは、何してたんだい？\n",
      "translation": "아아. 포르테는, 뭐 하고 있었어？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00089800:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "5,0050101",
        "voice": "GB450402,3",
        "face": "0,0050103,0"
      },
      "original": "ん……ちょっと考え事をね。\n",
      "translation": "음…… 잠깐 생각 좀 하느라.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00089800:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "1,0010105",
        "voice": "GB450402,3",
        "face": "0,0050103,0"
      },
      "original": "あ、じゃましちゃったかな？\n",
      "translation": "아, 방해한 걸까？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00089800:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "5,0050101",
        "voice": "GB450403,3",
        "face": "0,0050204,0"
      },
      "original": "いや、いいんだ。\nあたしひとりで考えてても、らちが明かない\n感じだったし。\n",
      "translation": "아니, 괜찮아. 나 혼자 생각하고 있어\n봤자, 진전이 없는 느낌이었으니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00089800:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "1,0010102",
        "voice": "GB450403,3",
        "face": "0,0050204,0"
      },
      "original": "え？\nいったい、どんな問題を考えてたんだ？\n",
      "translation": "에？ 도대체, 어떤 문제를 생각하고 있었던\n거야？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00089800:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "5,0050101",
        "voice": "GB450404,3",
        "face": "0,0050101,0"
      },
      "original": "まぁ……これからどうしようかなーってコト\nさ。\n",
      "translation": "뭐…… 앞으로 어떻게 할까～ 하는 거지.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00089800:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "1,0010401",
        "voice": "GB450404,3",
        "face": "0,0050101,0"
      },
      "original": "これからって……敵との戦いのこと？\n",
      "translation": "앞으로라니…… 적과의 싸움에 관한 거야？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00089800:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "5,0050101",
        "voice": "GB450405,3",
        "face": "0,0050103,0"
      },
      "original": "そう……クロノ・ブレイク・キャノンが効か\nない相手と、どうやって戦おうかってね。\n",
      "translation": "그래…… 크로노・브레이크・캐논이 통하지\n않는 상대와, 어떻게 싸울 것인가에 대해서\n말이지.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00089800:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "1,0010401",
        "voice": "GB450405,3",
        "face": "0,0050103,0"
      },
      "original": "その方法を見つけるために、オレたちは『白\nき月』に向かってるんじゃないか。\n",
      "translation": "그 방법을 찾기 위해서, 우리들은 『백색\n달』을 향해 가고 있는 거 아니겠어.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00089800:dialogue:0013",
      "channel": 1,
      "context": {
        "voice": "GB450406,3",
        "speaker": "5,0050101",
        "face": "0,0050101,0"
      },
      "original": "そうだけど、その前にいいアイデアが思いつ\nいたら、それはそれで役に立つかもしれない\nだろ？\n",
      "translation": "그렇긴 하지만, 그전에 좋은 아이디어가\n떠오른다면 그것대로 도움이 될지도\n모르잖아？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00089800:dialogue:0014",
      "channel": 1,
      "context": {
        "face": "0,0050101,0",
        "voice": "GB450406,3",
        "speaker": "1,0010102"
      },
      "original": "まぁ、確かに。\nそれで、何か思いついたの？\n",
      "translation": "뭐, 확실히. 그래서, 뭔가 떠오른 거야？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00089800:dialogue:0015",
      "channel": 1,
      "context": {
        "face": "0,0050205,0",
        "voice": "GB450407,3",
        "speaker": "5,0050101"
      },
      "original": "いやー、それがぜんっぜん！\n",
      "translation": "아니～ 그게 전혀！\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00089800:dialogue:0016",
      "channel": 1,
      "context": {
        "speaker": "1,0010105",
        "face": "0,0050205,0",
        "voice": "GB450407,3"
      },
      "original": "だろうなぁ。\nオレも同じだよ。\n",
      "translation": "그렇겠지. 나도 마찬가지야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00089800:dialogue:0017",
      "channel": 1,
      "context": {
        "face": "0,0050201,0",
        "voice": "GB450408,3",
        "speaker": "5,0050101"
      },
      "original": "……でも、何か手はあるはずなんだ。\nこの世界に、完ぺきとか絶対なんてものはな\nいんだから。\n",
      "translation": "……하지만, 분명 방법은 있을 거야. 이\n세상에 완벽이나 절대 같은 건 없으니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00089800:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "face": "0,0050201,0",
        "voice": "GB450408,3"
      },
      "original": "焦っても、しかたないよ。\nとりあえず、ちょっと気分転換したら？\n",
      "translation": "초조워해도 어쩔 수 없어. 일단, 기분\n전환이라도 좀 하는 게 어때？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00089800:dialogue:0019",
      "channel": 1,
      "context": {
        "speaker": "5,0050101",
        "face": "0,0050802,0",
        "voice": "GB450409,3"
      },
      "original": "そうだね。\n……といっても、何しようかな？\n",
      "translation": "그렇네. ……라고 해도, 뭘 할까？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00089800:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "face": "0,0050802,0",
        "voice": "GB450409,3"
      },
      "original": "そうだな、例えば……。\n",
      "translation": "글쎄, 예를 들면…….\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
