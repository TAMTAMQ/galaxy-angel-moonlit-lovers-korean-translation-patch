{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "SCENARIO_DAT_000a6800.txt",
    "encoding": "cp932",
    "sha256": "b807a1e4b5561c966ba6aff24296f01a6ba13c635661ea308736f23e27c59db2",
    "dialogue_count": 67
  },
  "units": [
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0001",
      "channel": 1,
      "context": {
        "face": "0,0060703,0",
        "voice": "GB540000,3",
        "speaker": "6,0060101"
      },
      "original": "……タクトさん……。\nちょっと、よろしいですか……？\n",
      "translation": "……택트 씨……. 잠시,\n괜찮으신가요……？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0002",
      "channel": 1,
      "context": {
        "face": "0,0060703,0",
        "voice": "GB540000,3",
        "speaker": "1,0010102"
      },
      "original": "うん？\nどうしたんだい、ヴァニラ。\n",
      "translation": "응？ 무슨 일이야, 바닐라.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0003",
      "channel": 1,
      "context": {
        "face": "0,0060701,0",
        "voice": "GB540001,3",
        "speaker": "6,0060101"
      },
      "original": "後で、甘いものをお持ちしようかと……思っ\nているのですが……。\n",
      "translation": "나중에, 단것을 가져다드릴까…… 하고\n생각 중입니다만…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0004",
      "channel": 1,
      "context": {
        "face": "0,0060701,0",
        "voice": "GB540001,3",
        "speaker": "1,0010102"
      },
      "original": "持っていくって、シヴァ様に？\n",
      "translation": "가져다드린다고, 시바 님께？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0005",
      "channel": 1,
      "context": {
        "face": "0,0060701,0",
        "voice": "GB540002,3",
        "speaker": "6,0060101"
      },
      "original": "はい……。\n甘いものを召し上がっていただいて、リラッ\nクスをと……。\n",
      "translation": "네……. 단것을 드시고, 휴식을\n취하시…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0006",
      "channel": 1,
      "context": {
        "face": "0,0060701,0",
        "voice": "GB540003,3",
        "speaker": "6,0060101"
      },
      "original": "ミルフィーさんに、作っていただこうと思い\nます……。\n",
      "translation": "밀피 씨에게 만들어 달라고 부탁할 생각입니다…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0007",
      "channel": 1,
      "context": {
        "face": "0,0060701,0",
        "voice": "GB540003,3",
        "speaker": "1,0010101"
      },
      "original": "グッドアイデアだ。\n気が利くね、ヴァニラは。\n",
      "translation": "굿 아이디어다. 센스가 좋네, 바닐라는.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0008",
      "channel": 1,
      "context": {
        "face": "0,0060703,0",
        "voice": "GB540004,3",
        "speaker": "6,0060101"
      },
      "original": "いえ……。\n",
      "translation": "아니에요…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0009",
      "channel": 1,
      "context": {
        "face": "0,0060703,0",
        "voice": "GB540004,3",
        "speaker": "1,0010101"
      },
      "original": "そうだ、だったらハーブティーも一緒に持っ\nていってあげなよ。\n",
      "translation": "그렇지, 그렇다면 허브티도 같이\n가져다드려.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0010",
      "channel": 1,
      "context": {
        "face": "0,0060703,0",
        "voice": "GB540004,3",
        "speaker": "1,0010101"
      },
      "original": "ヴァニラのいれるハーブティーは、おいしい\nからな。\nシヴァ様も、きっと気に入ってくれるよ。\n",
      "translation": "바닐라가 타는 허브티는 맛있으니까\n말이야. 시바 님도, 분명 마음에 들어 하실\n거야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0011",
      "channel": 1,
      "context": {
        "face": "0,0060702,0",
        "voice": "GB540005,3",
        "speaker": "6,0060101"
      },
      "original": "はい……そうします。\n",
      "translation": "네…… 그렇게 하겠습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0012",
      "channel": 1,
      "context": {
        "face": "0,0060702,0",
        "voice": "GB540005,3",
        "speaker": "1,0010101"
      },
      "original": "うん、よろしく。\n",
      "translation": "응, 부탁해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "11,0110401",
        "face": "0,0110401,0",
        "voice": "GB540006,3"
      },
      "original": "……………………。\n",
      "translation": "……………………。\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0014",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "face": "0,0110401,0",
        "voice": "GB540006,3"
      },
      "original": "お待たせしました、シヴァ様。\n",
      "translation": "기다리게 했습니다, 시바 님.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0015",
      "channel": 1,
      "context": {
        "face": "0,0110505,0",
        "voice": "GB540007,3",
        "speaker": "11,0110401"
      },
      "original": "……ヴァニラ・Ｈは、そなたをよく補佐して\nいるようだな。\n",
      "translation": "……바닐라・H는, 그대를 잘 보좌하고\n있는 모양이구나.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0016",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "voice": "GB540007,3",
        "face": "0,0110505,0"
      },
      "original": "はい。\n働き者だし、気が利くんです。\nいつも助けられてますよ。\n",
      "translation": "네. 성실한 데다 눈치도 빨라요. 항상\n도움을 받고 있어요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0017",
      "channel": 1,
      "context": {
        "voice": "GB540007,3",
        "speaker": "1,0010101",
        "face": "0,0110505,0"
      },
      "original": "さてと……休みといっても、何をしようかな？\n",
      "translation": "자 그럼…… 휴식이라고 해도, 뭘 할까？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "1,0010201",
        "face": "0,0110505,0",
        "voice": "GB540007,3"
      },
      "original": "そうだ、ヴァニラと話でもしてこよう。\n",
      "translation": "그래, 바닐라와 이야기라도 하고 오자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0019",
      "channel": 1,
      "context": {
        "face": "0,0110505,0",
        "speaker": "1,0010101",
        "voice": "GB540007,3"
      },
      "original": "ヴァニラがいるとすれば……あそこかな。\n",
      "translation": "바닐라가 있다면…… 저기일까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "1,0010102",
        "face": "0,0,0",
        "voice": "GB540007,3"
      },
      "original": "えーと……ヴァニラは、と……。\n",
      "translation": "음…… 바닐라는, 어디에…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0021",
      "channel": 1,
      "context": {
        "speaker": "6,0060101",
        "face": "0,0060703,0",
        "voice": "GB540100,3"
      },
      "original": "あ……。\n",
      "translation": "아…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0022",
      "channel": 1,
      "context": {
        "face": "0,0060703,0",
        "voice": "GB540100,3",
        "speaker": "1,0010101"
      },
      "original": "あ、いたいた。\nヴァニラ、何してたんだい？\n",
      "translation": "아, 여기 있었구나. 바닐라, 뭐 하고\n있었어？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0023",
      "channel": 1,
      "context": {
        "face": "0,0060903,0",
        "voice": "GB540101,3",
        "speaker": "6,0060101"
      },
      "original": "あの……あ、編み物……を……。\n",
      "translation": "저기…… 아, 뜨개질……을…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0024",
      "channel": 1,
      "context": {
        "speaker": "1,0010102",
        "face": "0,0060903,0",
        "voice": "GB540101,3"
      },
      "original": "編み物？\n",
      "translation": "뜨개질？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0025",
      "channel": 1,
      "context": {
        "face": "0,0060903,0",
        "voice": "GB540102,3",
        "speaker": "6,0060101"
      },
      "original": "もうすぐ、出来上がるところです……。\n",
      "translation": "이제 곧, 완성될 참이에요…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0026",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "face": "0,0060903,0",
        "voice": "GB540102,3"
      },
      "original": "そうなのか。\nがんばってね。\n",
      "translation": "그렇구나. 힘내.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0027",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "face": "0,0060903,0",
        "voice": "GB540102,3"
      },
      "original": "あ、ヴァニラ。\n隣でひなたぼっこしてもいいかな？\n",
      "translation": "아, 바닐라. 옆에서 햇볕쬐기 해도 될까？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0028",
      "channel": 1,
      "context": {
        "speaker": "6,0060101",
        "face": "0,0060905,0",
        "voice": "GB540103,3"
      },
      "original": "……はい。\n",
      "translation": "……네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0029",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "face": "0,0060905,0",
        "voice": "GB540103,3"
      },
      "original": "それじゃ、遠慮なく。\nよっこいしょっと。\n",
      "translation": "그럼, 사양 않고. 영차.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0030",
      "channel": 1,
      "context": {
        "speaker": "1,0010201",
        "face": "0,0,0",
        "voice": "GB540103,3"
      },
      "original": "……う～ん……ここはポカポカしてて、気持\nちいいなぁ。\n",
      "translation": "……으음…… 여기는 따끈따끈해서 기분\n좋네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0031",
      "channel": 1,
      "context": {
        "face": "0,0,0",
        "speaker": "6,0060304",
        "voice": "GB540104,3"
      },
      "original": "そうですね……。\n",
      "translation": "그렇네요…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0032",
      "channel": 1,
      "context": {
        "face": "0,0,0",
        "voice": "GB540104,3",
        "speaker": "1,0010101"
      },
      "original": "遠くに波の音が聞こえて……なんだか……眠\nくなってきたな……。\n",
      "translation": "멀리서 파도 소리가 들려서…… 왠지……\n졸려지네…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0033",
      "channel": 1,
      "context": {
        "speaker": "1,0010401",
        "face": "0,0,0",
        "voice": "GB540104,3"
      },
      "original": "……そういえば……\nヴァニラは……何を編んでるのかな……？\n",
      "translation": "……그러고 보니…… 바닐라는…… 무엇을\n뜨고 있는 걸까……？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0034",
      "channel": 1,
      "context": {
        "speaker": "1,0010401",
        "face": "0,0,0",
        "voice": "GB540104,3"
      },
      "original": "……何を…………。\n",
      "translation": "……무엇을………….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0035",
      "channel": 1,
      "context": {
        "voice": "GB540104,3",
        "speaker": "1,0",
        "face": "0,0,0"
      },
      "original": "…………………………。\n",
      "translation": "………………………….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0036",
      "channel": 1,
      "context": {
        "speaker": "6,0060701",
        "voice": "GB540105,3",
        "face": "0,0,0"
      },
      "original": "……タクトさん……。\n",
      "translation": "……택트 씨…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0037",
      "channel": 1,
      "context": {
        "voice": "GB540105,3",
        "speaker": "1,0010401",
        "face": "0,0,0"
      },
      "original": "……ん？\n",
      "translation": "……응？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0038",
      "channel": 1,
      "context": {
        "speaker": "1,0010105",
        "face": "0,0060701,0",
        "voice": "GB540105,3"
      },
      "original": "あ……一瞬、ウトウトしてたな。\nなんだい、ヴァニラ？\n",
      "translation": "아…… 잠깐, 꾸벅꾸벅 졸고 있었네. 왜\n그래, 바닐라？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0039",
      "channel": 1,
      "context": {
        "face": "0,0060701,0",
        "voice": "GB540106,3",
        "speaker": "6,0060101"
      },
      "original": "背中を……こちらに向けてもらえますか？\n",
      "translation": "등을…… 이쪽으로 향해주시겠어요？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0040",
      "channel": 1,
      "context": {
        "speaker": "1,0010102",
        "face": "0,0,0",
        "voice": "GB540106,3"
      },
      "original": "背中？\nああ、こうかい？\n",
      "translation": "등？ 아아, 이렇게 말이야？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0041",
      "channel": 1,
      "context": {
        "face": "0,0,0",
        "speaker": "6,0060701",
        "voice": "GB540107,3"
      },
      "original": "はい……そのまま、少しの間、動かないでく\nださい。\n",
      "translation": "네…… 그대로, 잠시 동안만 움직이지 말아\n주세요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0042",
      "channel": 1,
      "context": {
        "speaker": "1,0010105",
        "voice": "GB540107,3",
        "face": "0,0,0"
      },
      "original": "いいけど……何するんだい？\n",
      "translation": "알았어…… 뭘 하려는 거야？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0043",
      "channel": 1,
      "context": {
        "speaker": "6,0060903",
        "face": "0,0,0",
        "voice": "GB540108,3"
      },
      "original": "……………………。\n",
      "translation": "……………………。\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0044",
      "channel": 1,
      "context": {
        "face": "0,0,0",
        "speaker": "6,0060304",
        "voice": "GB540109,3"
      },
      "original": "……丈は……もう少しですね。\n",
      "translation": "……길이는…… 조금만 더 있으면\n되겠네요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0045",
      "channel": 1,
      "context": {
        "speaker": "1,0010102",
        "voice": "GB540109,3",
        "face": "0,0,0"
      },
      "original": "……これって、寸法を見てるの？\n",
      "translation": "……이거, 치수를 재고 있는 거야？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0046",
      "channel": 1,
      "context": {
        "speaker": "6,0060903",
        "voice": "GB540110,3",
        "face": "0,0,0"
      },
      "original": "はい。\n",
      "translation": "네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0047",
      "channel": 1,
      "context": {
        "speaker": "1,0010104",
        "voice": "GB540110,3",
        "face": "0,0,0"
      },
      "original": "ということは……。\nやっぱり、そのセーターは、オレの……？\n",
      "translation": "그렇다는 건…… 역시, 그 스웨터는,\n내……？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0048",
      "channel": 1,
      "context": {
        "speaker": "6,0060903",
        "voice": "GB540111,3",
        "face": "0,0,0"
      },
      "original": "はい。\n",
      "translation": "네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0049",
      "channel": 1,
      "context": {
        "speaker": "1,0010201",
        "voice": "GB540111,3",
        "face": "0,0,0"
      },
      "original": "そうかぁ。\n楽しみだな～！\n",
      "translation": "그렇구나. 기대되는데～！\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0050",
      "channel": 1,
      "context": {
        "voice": "GB540112,3",
        "speaker": "6,0060101",
        "face": "0,0060701,0"
      },
      "original": "もうすぐ、完成ですので……。\n",
      "translation": "곧 완성되니까…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0051",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "face": "0,0060701,0",
        "voice": "GB540112,3"
      },
      "original": "じゃあ、ヴァニラにお礼しなくちゃな。\n",
      "translation": "그럼, 바닐라에게 고맙다고 해야겠네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0052",
      "channel": 1,
      "context": {
        "face": "0,0060703,0",
        "speaker": "6,0060101",
        "voice": "GB540113,3"
      },
      "original": "そんな……私は……。\n",
      "translation": "그런…… 저는…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0053",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "voice": "GB540113,3",
        "face": "0,0060703,0"
      },
      "original": "いいから、いいから。\nオレがそうしたいんだ。\n",
      "translation": "괜찮아, 괜찮으니까. 내가 그러고 싶은\n거야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0054",
      "channel": 1,
      "context": {
        "voice": "GB540113,3",
        "speaker": "1,0010101",
        "face": "0,0060703,0"
      },
      "original": "セーターのお礼、か……。\nうーん、どんなことがいいかなぁ……？\n",
      "translation": "스웨터 선물이라…… 음, 어떤 게\n좋을까나……？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0055",
      "channel": 1,
      "context": {
        "voice": "GB540200,3",
        "speaker": "6,0060101",
        "face": "0,0060703,0"
      },
      "original": "……デート？\n",
      "translation": "……데이트？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0056",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "voice": "GB540200,3",
        "face": "0,0060703,0"
      },
      "original": "そうだよ、デートだ。\n一緒に行こうな。\n",
      "translation": "그래, 데이트야. 같이 가자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0057",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "voice": "GB540200,3",
        "face": "0,0060703,0"
      },
      "original": "指きりしよう。\n約束だ。\n",
      "translation": "손가락 걸고 약속하자. 약속이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0058",
      "channel": 1,
      "context": {
        "voice": "GB540201,3",
        "speaker": "6,0060101",
        "face": "0,0060702,0"
      },
      "original": "……はい、タクトさん。\n",
      "translation": "……네, 택트 씨.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0059",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "voice": "GB540201,3",
        "face": "0,0060702,0"
      },
      "original": "期待してるぞ、ヴァニラ。\n",
      "translation": "기대하고 있을게, 바닐라.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0060",
      "channel": 1,
      "context": {
        "voice": "GB540300,3",
        "speaker": "6,0060105",
        "face": "0,0060702,0"
      },
      "original": "はい、タクトさん。\n……私が、みなさんを守ります。\n",
      "translation": "네, 택트 씨. ……제가, 여러분을\n지키겠습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0061",
      "channel": 1,
      "context": {
        "voice": "GB540301,3",
        "speaker": "6,0060105",
        "face": "0,0060702,0"
      },
      "original": "タクトさんにも……指一本、触れさせません。\nですから、今度こそ『黒き月』を……。\n",
      "translation": "택트 씨에게도…… 손가락 하나, 대지\n못하게 하겠습니다. 그러니까 이번에야말로\n『흑색 달』을…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0062",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "face": "0,0060702,0",
        "voice": "GB540301,3"
      },
      "original": "そう言ってもらえると、オレも心強いよ。\n任せてくれ、『黒き月』は必ず破壊する。\n",
      "translation": "그렇게 말해주니 나도 든든하네. 맡겨줘,\n『흑색 달』은 반드시 파괴하겠다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0063",
      "channel": 1,
      "context": {
        "face": "0,0060702,0",
        "voice": "GB540302,3",
        "speaker": "3,0030105"
      },
      "original": "ひゅーひゅー！\nこんなときでも、見せつけてくれるわねー。\n",
      "translation": "휘유 휘유！ 이런 때에도 멋지게\n보여준다니까ー.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0064",
      "channel": 1,
      "context": {
        "speaker": "4,0040101",
        "face": "0,0060702,0",
        "voice": "GB540303,3"
      },
      "original": "ですが、安心しましたわ。\nタクトさんもヴァニラさんも、よけいな緊張\nはしていらっしゃらないようですわね。\n",
      "translation": "하지만 안심했습니다. 택트 씨도 바닐라\n씨도, 불필요한 긴장은 하고 있지 않으신\n듯하네요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0065",
      "channel": 1,
      "context": {
        "speaker": "107,1070102",
        "face": "0,0060702,0",
        "voice": "GB540304,3"
      },
      "original": "ハーベスターの修復機能があれば、私たちも\n心おきなく戦えます。\n",
      "translation": "하베스터의 수리 기능이 있다면, 저희도\n마음 놓고 싸울 수 있습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0066",
      "channel": 1,
      "context": {
        "speaker": "6,0060105",
        "face": "0,0060702,0",
        "voice": "GB540305,3"
      },
      "original": "みなさんは、攻撃に集中してください。\n……修理は、私が引き受けます。\n",
      "translation": "여러분은 공격에 집중해 주세요.\n……수리는, 제가 맡겠습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_000a6800:dialogue:0067",
      "channel": 1,
      "context": {
        "face": "0,0060702,0",
        "voice": "GB540305,3",
        "speaker": "1,0010302"
      },
      "original": "その意気だ。\n頼むぞ、みんな、ヴァニラ！\n",
      "translation": "그 기세다. 부탁한다, 모두들, 바닐라！\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
