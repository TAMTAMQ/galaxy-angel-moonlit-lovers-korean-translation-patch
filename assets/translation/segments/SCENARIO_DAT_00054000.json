{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "SCENARIO_DAT_00054000.txt",
    "encoding": "cp932",
    "sha256": "4fc345579e86088f6ac60e3e27217e16c9a6666b9a5d1cb0dbc218aeff006ca6",
    "dialogue_count": 18
  },
  "units": [
    {
      "id": "SCENARIO_DAT_00054000:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "1,0010101"
      },
      "original": "アルモ、作戦図をモニターへ。\n",
      "translation": "아르모, 작전도를 모니터로.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00054000:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "17,0170101",
        "voice": "GB110600,3"
      },
      "original": "了解。\n",
      "translation": "알았다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00054000:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "7,0070201",
        "voice": "GB311101,3",
        "face": "0,0,0"
      },
      "original": "現在の状況は、こうなっている。\n",
      "translation": "현재 상황은 이렇다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00054000:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "7,0070201",
        "voice": "GB311102,3",
        "face": "0,0,0"
      },
      "original": "エルシオールの現在位置は、ここだ。\n",
      "translation": "에르시올의 현재 위치는 여기다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00054000:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "7,0070201",
        "voice": "GBX210402,3",
        "face": "0,0,0"
      },
      "original": "敵艦隊の配置は、こうなっている。\n",
      "translation": "적 함대의 배치는 이렇다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00054000:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "7,0070301",
        "voice": "GBX311110,3",
        "face": "0,0,0"
      },
      "original": "完全に前後をふさがれた状態だ。\n気を抜くなよ、タクト。\n",
      "translation": "완전히 전후로 가로막힌 상태다. 방심하지\n마라, 택트.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00054000:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "1,0010403",
        "voice": "GBX311110,3",
        "face": "0,0,0"
      },
      "original": "後方の艦隊に、ミントのトリックマスターが\n囲まれている。\nこのままだとミントが危ない。\n",
      "translation": "후방의 함대가 민트의 트릭 마스터에게\n포위되어 있다. 이대로라면 민트가 위험해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00054000:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "1,0010301",
        "voice": "GBX311110,3",
        "face": "0,0,0"
      },
      "original": "ここは指揮系統を叩くしかないな。\nハーベスターとシャープシューターは、敵の\n旗艦だけを狙ってくれ。\n",
      "translation": "여기는 지휘 계통을 타격할 수밖에 없겠군.\n하베스터와 샤프 슈터는 적의 기함만을\n노려줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00054000:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "1,0010301",
        "voice": "GBX311110,3",
        "face": "0,0,0"
      },
      "original": "ミント、みんなが旗艦を倒すまで、持ちこた\nえてくれ。\n",
      "translation": "민트, 모두가 기함을 쓰러뜨릴 때까지\n버텨줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00054000:dialogue:0010",
      "channel": 1,
      "context": {
        "voice": "GB311112,3",
        "speaker": "4,0040701",
        "face": "0,0,0"
      },
      "original": "了解しました。\nなんとか、やってみますわ。\n",
      "translation": "알겠습니다. 어떻게든 해보겠어요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00054000:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "1,0010302",
        "face": "0,0,0",
        "voice": "GB311112,3"
      },
      "original": "以上だ。\n頼むぞ、みんな！\n",
      "translation": "이상이다. 부탁한다, 모두들！\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00054000:dialogue:0012",
      "channel": 0,
      "context": {
        "voice": "GB311112,3",
        "speaker": "999,0"
      },
      "original": "～敵部隊の編成～\n　大型戦艦×１　　　　戦艦×１\n　駆逐艦×７　　　　　巡洋艦×４\n　\n～勝利条件～\n　敵旗艦の破壊\n　\n～敗北条件～\n　エルシオールの破壊\n　タイムオーバー\n",
      "translation": "～적 부대 편성～대형\n전함×１　　　　전함×１구축함×７　　　\n　　순양함×４～승리 조건～적 기함의\n파괴～패배 조건～에르시올의 파괴 타임\n오버\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00054000:dialogue:0013",
      "channel": 1,
      "context": {
        "voice": "GB210409,3",
        "speaker": "7,0070101",
        "face": "0,0070101,0"
      },
      "original": "もう一度、作戦内容を確認するか？\n",
      "translation": "다시 한번, 작전 내용을 확인할까？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00054000:dialogue:0014",
      "channel": 1,
      "context": {
        "voice": "GB210409,3",
        "speaker": "1,0010401",
        "face": "0,0070101,0"
      },
      "original": "そうだなぁ……。\n",
      "translation": "글쎄...\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00054000:dialogue:0015",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "voice": "GB210409,3",
        "face": "0,0070101,0"
      },
      "original": "うん。\n念のため、もう一度確認しておこう。\n",
      "translation": "응. 만약을 위해, 다시 한번 확인해 두자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00054000:dialogue:0016",
      "channel": 1,
      "context": {
        "speaker": "1,0010301",
        "voice": "GB210409,3",
        "face": "0,0,0"
      },
      "original": "いや、その必要はない。\nみんな、準備はいいな？\n",
      "translation": "아니, 그럴 필요는 없다. 모두, 준비는\n됐나？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00054000:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "1,0010302",
        "voice": "GB210409,3",
        "face": "0,0,0"
      },
      "original": "エンジェル隊、出撃！\n",
      "translation": "엔젤대, 출격！\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00054000:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "998,0",
        "voice": "GB310412,3",
        "face": "0,0,0"
      },
      "original": "了解！\n",
      "translation": "네！\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
