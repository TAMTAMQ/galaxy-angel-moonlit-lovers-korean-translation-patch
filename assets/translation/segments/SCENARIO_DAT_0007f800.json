{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "SCENARIO_DAT_0007f800.txt",
    "encoding": "cp932",
    "sha256": "84c54ccaca53bca16d63ed613df594610d534c1248fa2489f73c6291590aa3a8",
    "dialogue_count": 23
  },
  "units": [
    {
      "id": "SCENARIO_DAT_0007f800:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "1,0010101"
      },
      "original": "アルモ、作戦図をモニターへ。\n",
      "translation": "아르모, 작전도를 모니터로.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0007f800:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "17,0170101",
        "voice": "GB110600,3"
      },
      "original": "了解。\n",
      "translation": "알았다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0007f800:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "7,0070101",
        "voice": "GB111601,3",
        "face": "0,0,0"
      },
      "original": "現在の状況は、こうなっている。\n",
      "translation": "현재 상황은, 이렇다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0007f800:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "7,0070201",
        "voice": "GB210402,3",
        "face": "0,0,0"
      },
      "original": "エルシオールの現在位置は、ここだ。\n",
      "translation": "에르시올의 현재 위치는, 여기다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0007f800:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "7,0070201",
        "voice": "GBX210402,3",
        "face": "0,0,0"
      },
      "original": "敵艦隊の配置は、こうなっている。\n",
      "translation": "적 함대의 배치는, 이렇다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0007f800:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "7,0070201",
        "voice": "GB210406,3",
        "face": "0,0,0"
      },
      "original": "以上だ。\nタクト、どうする？\n",
      "translation": "이상이다. 택트, 어떻게 할 거지？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0007f800:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "1,0010401",
        "voice": "GB210406,3",
        "face": "0,0,0"
      },
      "original": "レゾムが乗っている艦は……ここか。\n",
      "translation": "레좀이 타고 있는 함선은…… 여기인가.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0007f800:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "5,0050204",
        "voice": "GB420408,3",
        "face": "0,0,0"
      },
      "original": "なんだい、この艦は？\nこれ見よがしに武器つけまくって、センスの\nかけらもないねぇ。\n",
      "translation": "뭐야, 이 함선은？ 보란 듯이 무기를 잔뜩\n달아놓고, 센스라고는 눈을 씻고 봐도\n없네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0007f800:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "7,0070201",
        "voice": "GB420409,3",
        "face": "0,0,0"
      },
      "original": "だが、それなりに攻撃力はありそうだぞ。\n",
      "translation": "하지만, 나름대로 공격력은 있어 보이는데\n말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0007f800:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "5,0050204",
        "voice": "GB420410,3",
        "face": "0,0,0"
      },
      "original": "そんなの知ったこっちゃないよ。\nいいかい、武器ってのはねぇ……。\n",
      "translation": "그런 건 알 바 아니야. 잘 들어, 무기라는\n건 말이지…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0007f800:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "107,1070101",
        "voice": "GB420411,3",
        "face": "0,0,0"
      },
      "original": "フォルテ先輩、とにかく今は、敵を退けるの\nが先決です。\n",
      "translation": "포르테 선배, 어쨌든 지금은 적을 물리치는\n게 우선입니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0007f800:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "5,0050802",
        "voice": "GB420412,3",
        "face": "0,0,0"
      },
      "original": "……っと、そうだった。\n",
      "translation": "……앗, 그랬지.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0007f800:dialogue:0013",
      "channel": 1,
      "context": {
        "voice": "GB420413,3",
        "speaker": "5,0050101",
        "face": "0,0,0"
      },
      "original": "タクト、せっかく敵の親玉が出てきてくれた\nんだ。\nここでとっ捕まえてやろうよ。\n",
      "translation": "택트, 기왕 적의 우두머리가 나타나 준\n거니까. 여기서 붙잡아 버리자고.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0007f800:dialogue:0014",
      "channel": 1,
      "context": {
        "voice": "GB420413,3",
        "speaker": "1,0010101"
      },
      "original": "そうだな、あいつを捕まえれば、任務も完了\nだ。\n",
      "translation": "그렇군, 녀석을 잡으면 임무도 완료다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0007f800:dialogue:0015",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "voice": "GB420413,3"
      },
      "original": "よし、作戦目標は、敵旗艦の破壊とする。\n",
      "translation": "좋아, 작전 목표는 적 기함의 파괴로 한다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0007f800:dialogue:0016",
      "channel": 1,
      "context": {
        "voice": "GB420413,3",
        "speaker": "1,0010301"
      },
      "original": "以上だ。\n頼むぞ、ふたりとも！\n",
      "translation": "이상이다. 부탁한다, 둘 다！\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0007f800:dialogue:0017",
      "channel": 0,
      "context": {
        "voice": "GB420413,3",
        "speaker": "999,0"
      },
      "original": "～敵部隊の編成～\n　大型戦艦×１　　　　戦艦×１\n　駆逐艦×４　　　　　巡洋艦×４\n　\n～勝利条件～\n　敵旗艦の破壊\n　\n～敗北条件～\n　エルシオールの破壊\n　タイムオーバー\n",
      "translation": "～적 부대의 편성～대형\n전함×１　　　　전함×１\n구축함×４　　　　　순양함×４～승리\n조건～적 기함의 파괴～패배\n조건～에르시올의 파괴 타임 오버\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0007f800:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "7,0070101",
        "voice": "GB210409,3",
        "face": "0,0070101,0"
      },
      "original": "もう一度、作戦内容を確認するか？\n",
      "translation": "다시 한번, 작전 내용을 확인할까？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0007f800:dialogue:0019",
      "channel": 1,
      "context": {
        "speaker": "1,0010401",
        "voice": "GB210409,3",
        "face": "0,0070101,0"
      },
      "original": "そうだなぁ……。\n",
      "translation": "글쎄...\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0007f800:dialogue:0020",
      "channel": 1,
      "context": {
        "voice": "GB210409,3",
        "speaker": "1,0010101",
        "face": "0,0070101,0"
      },
      "original": "うん。\n念のため、もう一度確認しておこう。\n",
      "translation": "응. 만약을 위해, 다시 한번 확인해 두자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0007f800:dialogue:0021",
      "channel": 1,
      "context": {
        "speaker": "1,0010301",
        "voice": "GB210409,3",
        "face": "0,0,0"
      },
      "original": "いや、その必要はない。\nみんな、準備はいいな？\n",
      "translation": "아니, 그럴 필요는 없다. 모두, 준비는\n됐나？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0007f800:dialogue:0022",
      "channel": 1,
      "context": {
        "voice": "GB210409,3",
        "speaker": "1,0010302",
        "face": "0,0,0"
      },
      "original": "エンジェル隊、出撃！\n",
      "translation": "엔젤대, 출격！\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0007f800:dialogue:0023",
      "channel": 1,
      "context": {
        "voice": "GB410610,3",
        "speaker": "998,0",
        "face": "0,0,0"
      },
      "original": "了解！\n",
      "translation": "네！\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
