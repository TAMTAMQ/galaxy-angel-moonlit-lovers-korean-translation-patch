{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "SCENARIO_DAT_00093800.txt",
    "encoding": "cp932",
    "sha256": "57f36c7505e57178cc49949bc1d98961bace2133e7fb398e0d33df89ceb7a816",
    "dialogue_count": 27
  },
  "units": [
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "1,0010101"
      },
      "original": "アルモ、作戦図をモニターへ。\n",
      "translation": "아르모, 작전도를 모니터로.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "17,0170101",
        "voice": "GB110600,3"
      },
      "original": "了解。\n",
      "translation": "알았다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "7,0070101",
        "voice": "GB111601,3",
        "face": "0,0,0"
      },
      "original": "現在の状況は、こうなっている。\n",
      "translation": "현재 상황은 이렇다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "7,0070201",
        "voice": "GB210402,3",
        "face": "0,0,0"
      },
      "original": "エルシオールの現在位置は、ここだ。\n",
      "translation": "에르시올의 현재 위치는 여기다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "7,0070201",
        "voice": "GBX210402,3",
        "face": "0,0,0"
      },
      "original": "敵艦隊の配置は、こうなっている。\n",
      "translation": "적 함대의 배치는 이렇다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "7,0070201",
        "voice": "GB210406,3",
        "face": "0,0,0"
      },
      "original": "以上だ。\nタクト、どうする？\n",
      "translation": "이상이다. 택트, 어떻게 할 거지？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "1,0010301",
        "voice": "GB210406,3",
        "face": "0,0,0"
      },
      "original": "カンフーファイターとシャープシューターは、\nハーベスターに合流し、敵の迎撃にあたって\nくれ。\n",
      "translation": "쿵푸 파이터와 샤프 슈터는 하베스터에\n합류해 적의 요격을 맡아줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "1,0010301",
        "voice": "GB210406,3",
        "face": "0,0,0"
      },
      "original": "エルシオールは、現在の位置に留まる。\n",
      "translation": "에르시올은 현재 위치에 머문다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "voice": "GB210406,3",
        "face": "0,0,0"
      },
      "original": "ハーベスターがいれば、補給が必要な事態に\nもならないだろうしな。\nヴァニラ、みんなの修理は頼むよ。\n",
      "translation": "하베스터가 있다면 보급이 필요한 사태도\n일어나지 않을 테니까 말이야. 바닐라,\n모두의 수리는 부탁할게.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "6,0060101",
        "voice": "GB510307,3",
        "face": "0,0,0"
      },
      "original": "了解しました。\n",
      "translation": "알겠습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "3,0030104",
        "voice": "GB510308,3",
        "face": "0,0,0"
      },
      "original": "タクトも相変わらずねぇ。\nまーた、ヴァニラに重労働させるつもり？\n",
      "translation": "택트도 여전하네. 또 바닐라에게 중노동을\n시킬 생각이야？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "voice": "GB510308,3",
        "face": "0,0,0"
      },
      "original": "ヴァニラを信頼してるのさ。\n",
      "translation": "바닐라를 신뢰하고 있는 거야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0013",
      "channel": 1,
      "context": {
        "voice": "GB510308,3",
        "speaker": "1,0010101",
        "face": "0,0,0"
      },
      "original": "それに、みんなのダメージが少なくなれば、\nそれだけヴァニラの負担も減るってものだろ\nう？\n",
      "translation": "게다가, 모두의 데미지가 적어지면 그만큼\n바닐라의 부담도 줄어드는 법이잖아？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0014",
      "channel": 1,
      "context": {
        "voice": "GB510309,3",
        "speaker": "3,0030102"
      },
      "original": "ものは言いようね。\n",
      "translation": "말은 잘하네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0015",
      "channel": 1,
      "context": {
        "voice": "GB510309,3",
        "speaker": "1,0010101"
      },
      "original": "というわけで、よろしく頼むよ。\n以上だ。\n",
      "translation": "그런 의미에서, 잘 부탁해. 이상이다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0016",
      "channel": 0,
      "context": {
        "voice": "GB510309,3",
        "speaker": "999,0"
      },
      "original": "～敵部隊の編成～\n　駆逐艦×５　　　　　　巡洋艦×３\n　\n～勝利条件～\n　敵艦隊の全滅\n　\n～敗北条件～\n　エルシオールの破壊\n　タイムオーバー\n",
      "translation": "～적 부대의\n편성～구축함×５　　　　　　순양함×３～\n승리 조건～적 함대의 전멸～패배\n조건～에르시올의 파괴 타임 오버\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "7,0070101",
        "voice": "GB210409,3",
        "face": "0,0070101,0"
      },
      "original": "もう一度、作戦内容を確認するか？\n",
      "translation": "다시 한번, 작전 내용을 확인할까？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0018",
      "channel": 1,
      "context": {
        "voice": "GB210409,3",
        "speaker": "1,0010401",
        "face": "0,0070101,0"
      },
      "original": "そうだなぁ……。\n",
      "translation": "글쎄...\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0019",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "voice": "GB210409,3",
        "face": "0,0070101,0"
      },
      "original": "うん。\n念のため、もう一度確認しておこう。\n",
      "translation": "응. 만약을 위해, 다시 한번 확인해 두자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "1,0010301",
        "voice": "GB210409,3",
        "face": "0,0070101,0"
      },
      "original": "いや、その必要はない。\nみんな、準備はいいな？\n",
      "translation": "아니, 그럴 필요는 없어. 다들, 준비는\n됐나？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0021",
      "channel": 1,
      "context": {
        "voice": "GB510311,3",
        "speaker": "3,0030101",
        "face": "0,0070101,0"
      },
      "original": "いつでもいいわよ！\n",
      "translation": "언제든 괜찮아요！\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0022",
      "channel": 1,
      "context": {
        "voice": "GB510312,3",
        "speaker": "107,1070103",
        "face": "0,0070101,0"
      },
      "original": "はい、マイヤーズ司令。\n足手まといにならないように、先輩方の戦い\n方を勉強させていただきます。\n",
      "translation": "네, 마이어스 사령관님. 방해가 되지\n않도록 선배님들의 전투 방식을\n배우겠습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0023",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "voice": "GB510312,3",
        "face": "0,0070101,0"
      },
      "original": "まぁ、あまりかたくならずにね。\n",
      "translation": "뭐, 너무 긴장하지 말고 말이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0024",
      "channel": 1,
      "context": {
        "voice": "GB510312,3",
        "speaker": "1,0010101",
        "face": "0,0070101,0"
      },
      "original": "ヴァニラも、よろしく頼んだよ。\n",
      "translation": "바닐라도 잘 부탁해.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0025",
      "channel": 1,
      "context": {
        "speaker": "6,0060101",
        "face": "0,0070101,0",
        "voice": "GB510313,3"
      },
      "original": "……はい、タクトさん。\n",
      "translation": "……네, 택트 씨.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0026",
      "channel": 1,
      "context": {
        "speaker": "1,0010302",
        "face": "0,0070101,0",
        "voice": "GB510313,3"
      },
      "original": "それじゃあ、エンジェル隊、出撃！\n",
      "translation": "그럼, 엔젤대, 출격！\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00093800:dialogue:0027",
      "channel": 1,
      "context": {
        "speaker": "998,0",
        "face": "0,0070101,0",
        "voice": "GB510314,3"
      },
      "original": "了解！\n",
      "translation": "네！\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
