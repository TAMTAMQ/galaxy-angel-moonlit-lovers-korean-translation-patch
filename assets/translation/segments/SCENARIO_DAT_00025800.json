  },
  "units": [
    {
      "id": "SCENARIO_DAT_00025800:dialogue:0001",
      "channel": 1,
      "context": {
        "face": "0,0020904,0",
        "voice": "GB150400,3",
        "speaker": "2,0020101"
      },
      "original": "……………………。\n",
      "translation": "……………………。\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00025800:dialogue:0002",
      "channel": 1,
      "context": {
        "face": "0,0020904,0",
        "voice": "GB150400,3",
        "speaker": "1,0010102"
      },
      "original": "うん？\nミルフィー、どうしたんだい？\n",
      "translation": "응？ 밀피, 왜 그래？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00025800:dialogue:0003",
      "channel": 1,
      "context": {
        "face": "0,0020901,0",
        "voice": "GB150401,3",
        "speaker": "2,0020101"
      },
      "original": "あっ……いえ、別に。\n",
      "translation": "앗…… 아뇨, 별일 아니에요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00025800:dialogue:0004",
      "channel": 1,
      "context": {
        "face": "0,0020901,0",
        "voice": "GB150401,3",
        "speaker": "1,0010102"
      },
      "original": "もうお祈りは終わったの？\nそれにしては、浮かない顔だけど……。\n",
      "translation": "벌써 기도는 끝난 거야？ 그러기엔 표정이\n안 좋은데…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00025800:dialogue:0005",
      "channel": 1,
      "context": {
        "face": "0,0020201,0",
        "voice": "GB150402,3",
        "speaker": "2,0020101"
      },
      "original": "いえ、それは……。\n",
      "translation": "아니, 그건…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00025800:dialogue:0006",
      "channel": 1,
      "context": {
        "face": "0,0020202,0",
        "voice": "GB150403,3",
        "speaker": "2,0020101"
      },
      "original": "……立ち話もなんですから、よかったら、中\nに入りませんか？\n",
      "translation": "……계속 서서 이야기할 수도 없으니까,\n괜찮으시면 안으로 들어가지 않을래요？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00025800:dialogue:0007",
      "channel": 1,
      "context": {
        "face": "0,0020202,0",
        "voice": "GB150403,3",
        "speaker": "1,0010102"
      },
      "original": "ああ、そうだね。\nおじゃまするよ。\n",
      "translation": "아아, 그렇네. 실례할게.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00025800:dialogue:0008",
      "channel": 1,
      "context": {
        "face": "0,0020202,0",
        "voice": "GB150403,3",
        "speaker": "1,0010401"
      },
      "original": "……それで、どうしたんだい？\n",
      "translation": "……그래서, 무슨 일이야？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00025800:dialogue:0009",
      "channel": 1,
      "context": {
        "face": "0,0020904,0",
        "voice": "GB150404,3",
        "speaker": "2,0020101"
      },
      "original": "……タクトさん……あたし、怖いんです。\n",
      "translation": "……택트 씨…… 저, 무서워요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00025800:dialogue:0010",
      "channel": 1,
      "context": {
        "face": "0,0020904,0",
        "voice": "GB150405,3",
        "speaker": "2,0020101"
      },
      "original": "敵はあんなに強くて、だけど正体もよくわか\nらなくて……。\n",
      "translation": "적은 그렇게나 강하고, 그런데 정체도 잘\n모르겠고…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00025800:dialogue:0011",
      "channel": 1,
      "context": {
        "face": "0,0020904,0",
        "voice": "GB150405,3",
        "speaker": "1,0010401"
      },
      "original": "……………………。\n",
      "translation": "……………………。\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00025800:dialogue:0012",
      "channel": 1,
      "context": {
        "face": "0,0020202,0",
        "voice": "GB150406,3",
        "speaker": "2,0020101"
      },
      "original": "あたしたち、本当に勝てるんでしょうか？\nこのままだと、みんなメチャクチャにされちゃ\nうような気がして……。\n",
      "translation": "우리들, 정말로 이길 수 있는 걸까요？\n이대로라면, 모두 엉망진창이 되어버릴 것\n같은 기분이 들어서…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00025800:dialogue:0013",
      "channel": 1,
      "context": {
        "face": "0,0020201,0",
        "voice": "GB150407,3",
        "speaker": "2,0020101"
      },
      "original": "エルシオールも、紋章機も、皇国も、『白き\n月』も、みんな……。\n",
      "translation": "에르시올도, 문장기도, 황국도, 『백색\n달』도, 모두…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00025800:dialogue:0014",
      "channel": 1,
      "context": {
        "speaker": "2,0020101",
        "face": "0,0020904,0",
        "voice": "GB150408,3"
      },
      "original": "それに、タクトさんも……。\n",
      "translation": "게다가, 택트 씨도…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00025800:dialogue:0015",
      "channel": 1,
      "context": {
        "face": "0,0020904,0",
        "voice": "GB150408,3",
        "speaker": "1,0010401"
      },
      "original": "……ミルフィー……。\n",
      "translation": "……밀피…….\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
