{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "SCENARIO_DAT_00020000.txt",
    "encoding": "cp932",
    "sha256": "15372b6f8fb91564370d914df329ee787c940bc513c26fdbfa43924ba69c32c3",
    "dialogue_count": 21
  },
  "units": [
    {
      "id": "SCENARIO_DAT_00020000:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "1,0010101"
      },
      "original": "アルモ、作戦図をモニターへ。\n",
      "translation": "아르모, 작전도를 모니터로.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00020000:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "17,0170101",
        "voice": "GB110600,3"
      },
      "original": "了解。\n",
      "translation": "알았다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00020000:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "7,0070101",
        "voice": "GB930401,3",
        "face": "0,0,0"
      },
      "original": "現在の状況は、こうなっている。\n",
      "translation": "현재 상황은 이렇다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00020000:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "7,0070201",
        "voice": "GB930402,3",
        "face": "0,0,0"
      },
      "original": "エルシオールの現在位置は、ここだ。\n",
      "translation": "에르시올의 현재 위치는 여기다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00020000:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "7,0070102",
        "voice": "GB930403,3",
        "face": "0,0,0"
      },
      "original": "それから、合流した紋章機はこの位置にいる。\nうまい具合に敵の側面をついた形になったな。\n",
      "translation": "그리고 합류한 문장기는 이 위치에 있다.\n운 좋게 적의 측면을 찌른 형태가 되었군.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00020000:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "7,0070101",
        "voice": "GBX210402,3",
        "face": "0,0,0"
      },
      "original": "敵艦隊の配置は、こうなっている。\n",
      "translation": "적 함대의 배치는 이렇다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00020000:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "7,0070201",
        "voice": "GB930409,3",
        "face": "0,0,0"
      },
      "original": "ほかにも、敵主力部隊の戦闘艦がこの宙域に\n集まり始めている。\n",
      "translation": "그 외에도 적 주력 부대의 전투함이 이\n우역에 모이기 시작하고 있다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00020000:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "1,0010401",
        "voice": "GB930409,3",
        "face": "0,0,0"
      },
      "original": "のんびりやっているヒマは、なさそうだね。\n",
      "translation": "느긋하게 있을 틈은 없어 보이네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00020000:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "voice": "GB930409,3",
        "face": "0,0,0"
      },
      "original": "となると、指揮系統を狙うのが一番だな。\n作戦目標は、敵旗艦の破壊だ。\n",
      "translation": "그렇다면 지휘 계통을 노리는 게 가장\n좋겠군. 작전 목표는 적 기함의 파괴다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00020000:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "voice": "GB930409,3",
        "face": "0,0,0"
      },
      "original": "レゾムは喜び勇んで、自分だけ飛び出してき\nたみたいだから、旗艦のまわりは手薄になっ\nている。\n",
      "translation": "레좀은 의욕에 넘쳐 혼자서 튀어나간 것\n같으니, 기함 주변은 허술해져 있다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00020000:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "voice": "GB930409,3",
        "face": "0,0,0"
      },
      "original": "側面にいる紋章機は、全速で敵旗艦に接近し\nて、これを叩いてくれ。\n",
      "translation": "측면에 있는 문장기는, 전속력으로 적\n기함에 접근해서, 이것을 격파해 줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00020000:dialogue:0012",
      "channel": 1,
      "context": {
        "voice": "GB930409,3",
        "speaker": "1,0010101"
      },
      "original": "ほかの紋章機は、エルシオールの防御を頼む。\n",
      "translation": "다른 문장기는, 에르시올의 방어를\n부탁한다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00020000:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "voice": "GB930409,3"
      },
      "original": "手間取っていると、敵の主力部隊が到着して\nしまうから、気をつけてくれ。\n",
      "translation": "지체하고 있으면, 적의 주력 부대가 도착해\n버리니까, 주의해 줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00020000:dialogue:0014",
      "channel": 1,
      "context": {
        "voice": "GB930409,3",
        "speaker": "1,0010301"
      },
      "original": "以上だ。\n頼むぞ、みんな！\n",
      "translation": "이상이다. 부탁한다, 모두！\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00020000:dialogue:0015",
      "channel": 0,
      "context": {
        "voice": "GB930409,3",
        "speaker": "999,0"
      },
      "original": "～敵部隊の編成～\n　大型戦艦×１　　　　戦艦×１\n　高速突撃艦×２　　　装甲ミサイル艦×１\n　駆逐艦×４\n　\n～勝利条件～\n　敵旗艦の破壊\n　\n～敗北条件～\n　エルシオールの破壊\n　タイムオーバー\n",
      "translation": "～적 부대의 편성～대형\n전함×１　　　　전함×１고속\n돌격함×２　　　장갑\n미사일함×１구축함×４～승리 조건～적\n기함의 파괴～패배 조건～에르시올의 파괴\n타임 오버\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00020000:dialogue:0016",
      "channel": 1,
      "context": {
        "voice": "GB210409,3",
        "speaker": "7,0070101",
        "face": "0,0070101,0"
      },
      "original": "もう一度、作戦内容を確認するか？\n",
      "translation": "다시 한번, 작전 내용을 확인할까？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00020000:dialogue:0017",
      "channel": 1,
      "context": {
        "voice": "GB210409,3",
        "speaker": "1,0010401",
        "face": "0,0070101,0"
      },
      "original": "そうだなぁ……。\n",
      "translation": "글쎄…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00020000:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "face": "0,0070101,0",
        "voice": "GB210409,3"
      },
      "original": "うん。\n念のため、もう一度確認しておこう。\n",
      "translation": "응. 만약을 위해, 다시 한번 확인해 두자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00020000:dialogue:0019",
      "channel": 1,
      "context": {
        "speaker": "1,0010301",
        "face": "0,0,0",
        "voice": "GB210409,3"
      },
      "original": "いや、その必要はない。\nみんな、準備はいいな？\n",
      "translation": "아니, 그럴 필요는 없다. 모두, 준비는\n됐나？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00020000:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "1,0010302",
        "face": "0,0,0",
        "voice": "GB210409,3"
      },
      "original": "エンジェル隊、出撃！\n",
      "translation": "엔젤대, 출격！\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00020000:dialogue:0021",
      "channel": 1,
      "context": {
        "speaker": "998,0",
        "face": "0,0,0",
        "voice": "GB930411,3"
      },
      "original": "了解！\n",
      "translation": "알았다！\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
