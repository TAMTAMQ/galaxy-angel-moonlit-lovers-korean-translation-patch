{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "SCENARIO_DAT_00033800.txt",
    "encoding": "cp932",
    "sha256": "8955bd7a866b166b882dd656385ccdac6441acec4a5842e5be281c6352a31168",
    "dialogue_count": 25
  },
  "units": [
    {
      "id": "SCENARIO_DAT_00033800:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "1,0010101"
      },
      "original": "アルモ、作戦図をモニターへ。\n",
      "translation": "아르모, 작전도를 모니터로.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00033800:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "17,0170101",
        "voice": "GB210400,3"
      },
      "original": "了解。\n",
      "translation": "알았다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00033800:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "7,0070201",
        "voice": "GB210401,3",
        "face": "0,0,0"
      },
      "original": "現在の状況は、こうなっている。\n",
      "translation": "현재 상황은 이렇다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00033800:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "7,0070101",
        "voice": "GB210402,3",
        "face": "0,0,0"
      },
      "original": "エルシオールの現在位置は、ここだ。\n",
      "translation": "에르시올의 현재 위치는 여기다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00033800:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "7,0070101",
        "voice": "GBX210402,3",
        "face": "0,0,0"
      },
      "original": "敵艦隊の配置は、こうなっている。\n",
      "translation": "적 함대의 배치는 이렇다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00033800:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "7,0070101",
        "voice": "GB210406,3",
        "face": "0,0,0"
      },
      "original": "以上だ。\nタクト、どうする？\n",
      "translation": "이상이다. 택트, 어떻게 할 거지？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00033800:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "1,0010301",
        "voice": "GB210406,3",
        "face": "0,0,0"
      },
      "original": "ラッキースター、トリックマスター、シャー\nプシューターは、カンフーファイターに合流\nし、敵の迎撃にあたってくれ。\n",
      "translation": "럭키 스타, 트릭 마스터, 샤프 슈터는 쿵푸\n파이터와 합류해서 적의 요격을 맡아줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00033800:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "1,0010301",
        "voice": "GB210406,3",
        "face": "0,0,0"
      },
      "original": "エルシオールは、現在の位置に留まる。\n",
      "translation": "에르시올은 현재 위치에 머문다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00033800:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "4,0040103",
        "voice": "GB210407,3",
        "face": "0,0,0"
      },
      "original": "タクトさん、念のため申し上げておきますが、\nヴァニラさんがいらっしゃいませんから、ハー\nベスターの修復機能は使えませんわよ。\n",
      "translation": "택트 씨, 만약을 위해 말씀드려 두겠는데,\n바닐라 씨가 계시지 않으니 하베스터의\n수리 기능은 사용할 수 없답니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00033800:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "2,0020202",
        "voice": "GB210408,3",
        "face": "0,0,0"
      },
      "original": "紋章機の修理は、エルシオールまで戻らない\nとできませんから、よろしくお願いしますね。\n",
      "translation": "문장기 수리는 에르시올까지 돌아가지\n않으면 할 수 없으니까, 잘 부탁할게요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00033800:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "1,0010401",
        "voice": "GB210408,3",
        "face": "0,0,0"
      },
      "original": "わかったよ。\n前線からエルシオールまで往復する時間も、\n考えないといけないわけだな。\n",
      "translation": "알았어. 전선에서 에르시올까지 왕복하는\n시간도 고려해야 한다는 거군.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00033800:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "face": "0,0,0",
        "voice": "GB210408,3"
      },
      "original": "よし、以上だ。\n頼むぞ、みんな！\n",
      "translation": "좋아, 이상이다. 부탁한다, 모두！\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00033800:dialogue:0013",
      "channel": 0,
      "context": {
        "voice": "GB210408,3",
        "speaker": "999,0"
      },
      "original": "～敵部隊の編成～\n　駆逐艦×５　　　　　　巡洋艦×３\n　\n～勝利条件～\n　敵艦隊の全滅\n　\n～敗北条件～\n　エルシオールの破壊\n　タイムオーバー\n",
      "translation": "～적 부대\n편성～구축함×５　　　　　　순양함×３～\n승리 조건～적 함대의 전멸～패배\n조건～에르시올의 파괴 타임 오버\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00033800:dialogue:0014",
      "channel": 1,
      "context": {
        "speaker": "7,0070101",
        "voice": "GB210409,3",
        "face": "0,0070101,0"
      },
      "original": "もう一度、作戦内容を確認するか？\n",
      "translation": "다시 한번, 작전 내용을 확인할까？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00033800:dialogue:0015",
      "channel": 1,
      "context": {
        "voice": "GB210409,3",
        "speaker": "1,0010401",
        "face": "0,0070101,0"
      },
      "original": "そうだなぁ……。\n",
      "translation": "글쎄…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00033800:dialogue:0016",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "voice": "GB210409,3",
        "face": "0,0070101,0"
      },
      "original": "うん。\n念のため、もう一度確認しておこう。\n",
      "translation": "응. 만약을 위해, 다시 한번 확인해 두자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00033800:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "1,0010301",
        "voice": "GB210409,3",
        "face": "0,0,0"
      },
      "original": "いや、その必要はない。\nみんな、準備はいいな？\n",
      "translation": "아니, 그럴 필요는 없다. 모두, 준비는\n됐나？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00033800:dialogue:0018",
      "channel": 1,
      "context": {
        "voice": "GB210410,3",
        "speaker": "2,0020902",
        "face": "0,0,0"
      },
      "original": "はい、大丈夫です！\n",
      "translation": "네, 괜찮습니다！\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00033800:dialogue:0019",
      "channel": 1,
      "context": {
        "voice": "GB210411,3",
        "speaker": "4,0040101",
        "face": "0,0,0"
      },
      "original": "いつでもご命令をどうぞ。\n",
      "translation": "언제든 명령을 내려주십시오.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00033800:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "107,1070103",
        "face": "0,0,0",
        "voice": "GB210412,3"
      },
      "original": "シャープシューター、準備完了。\nマイヤーズ司令の名を汚さないよう、精一杯\n努力します。\n",
      "translation": "샤프 슈터, 준비 완료. 마이어스 사령관의\n이름을 더럽히지 않도록, 최선을\n다하겠습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00033800:dialogue:0021",
      "channel": 1,
      "context": {
        "speaker": "3,0030101",
        "face": "0,0,0",
        "voice": "GB210413,3"
      },
      "original": "もっとリラックスしなさいよ。\nとりあえず、自分の身を守れれば十分よ。\n後はアタシたちが、なんとかするから。\n",
      "translation": "좀 더 긴장 풀어. 일단 자기 몸을 지킬 수\n있으면 충분해. 나머지는 우리가 어떻게든\n할 테니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00033800:dialogue:0022",
      "channel": 1,
      "context": {
        "speaker": "3,0030804",
        "face": "0,0,0",
        "voice": "GB210414,3"
      },
      "original": "さあタクト、行きましょ！\n",
      "translation": "자, 택트, 가요！\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00033800:dialogue:0023",
      "channel": 1,
      "context": {
        "face": "0,0,0",
        "voice": "GB210414,3",
        "speaker": "1,0010301"
      },
      "original": "ああ、ランファ。\nオレたちの力を見せてやろう！\n",
      "translation": "아아, 란파. 우리들의 힘을 보여주자！\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00033800:dialogue:0024",
      "channel": 1,
      "context": {
        "face": "0,0,0",
        "voice": "GB210414,3",
        "speaker": "1,0010302"
      },
      "original": "それじゃあ、エンジェル隊、出撃！\n",
      "translation": "그럼, 엔젤대, 출격！\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00033800:dialogue:0025",
      "channel": 1,
      "context": {
        "speaker": "998,0",
        "face": "0,0,0",
        "voice": "GB210415,3"
      },
      "original": "了解！\n",
      "translation": "네！\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
