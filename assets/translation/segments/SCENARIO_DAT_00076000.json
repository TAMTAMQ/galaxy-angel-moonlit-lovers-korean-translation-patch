{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "SCENARIO_DAT_00076000.txt",
    "encoding": "cp932",
    "sha256": "d4da2862e0d5a74573e3a28cab6e7d96f4851d94f7e2b839b957a312df6f1dd4",
    "dialogue_count": 21
  },
  "units": [
    {
      "id": "SCENARIO_DAT_00076000:dialogue:0001",
      "channel": 1,
      "context": {
        "speaker": "1,0010301"
      },
      "original": "アルモ、作戦図をモニターへ。\n",
      "translation": "아르모, 작전도를 모니터로.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00076000:dialogue:0002",
      "channel": 1,
      "context": {
        "speaker": "17,0170101",
        "face": "0170101,0,0",
        "voice": "GB110600,3"
      },
      "original": "了解。\n",
      "translation": "네.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00076000:dialogue:0003",
      "channel": 1,
      "context": {
        "speaker": "7,0070201",
        "face": "0,0,0",
        "voice": "GB411201,3"
      },
      "original": "現在の状況は、こうなっている。\n",
      "translation": "현재 상황은 이렇다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00076000:dialogue:0004",
      "channel": 1,
      "context": {
        "speaker": "7,0070201",
        "face": "0,0,0",
        "voice": "GB411202,3"
      },
      "original": "エルシオールの現在位置は、ここだ。\n",
      "translation": "에르시올의 현재 위치는 여기다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00076000:dialogue:0005",
      "channel": 1,
      "context": {
        "speaker": "7,0070201",
        "face": "0,0,0",
        "voice": "GBX210402,3"
      },
      "original": "敵艦隊の配置は、こうなっている。\n",
      "translation": "적 함대의 배치는 이렇다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00076000:dialogue:0006",
      "channel": 1,
      "context": {
        "speaker": "7,0070201",
        "face": "0,0,0",
        "voice": "GB411206,3"
      },
      "original": "そして、民間船の位置はここだ。\n正直言って、かなりまずい位置関係だな。\n",
      "translation": "그리고, 민간선의 위치는 여기다. 솔직히\n말해서, 상당히 곤란한 위치 관계군.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00076000:dialogue:0007",
      "channel": 1,
      "context": {
        "speaker": "1,0010401",
        "face": "0,0,0",
        "voice": "GB411206,3"
      },
      "original": "確かに、エルシオールとの距離がありすぎる。\n紋章機でも間に合うかどうか……。\n",
      "translation": "확실히, 에르시올과의 거리가 너무 멀어.\n문장기로도 늦지 않을지…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00076000:dialogue:0008",
      "channel": 1,
      "context": {
        "speaker": "5,0050801",
        "face": "0,0,0",
        "voice": "GB411207,3"
      },
      "original": "なんとかしてみせるさ。\nとにかく、民間船にはうまいこと逃げるよう\nに伝えとくれ。\n",
      "translation": "어떻게든 해 보이겠어. 어쨌든, 민간선에는\n잘 도망치라고 전해줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00076000:dialogue:0009",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "face": "0,0,0",
        "voice": "GB411207,3"
      },
      "original": "わかった、フォルテ。\n",
      "translation": "알았어, 포르테.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00076000:dialogue:0010",
      "channel": 1,
      "context": {
        "speaker": "1,0010301",
        "face": "0,0,0",
        "voice": "GB411207,3"
      },
      "original": "アルモ、民間船にこのポイントへ逃げるよう\nに伝えてくれ。\n",
      "translation": "아르모, 민간선에 이 포인트로 도망치라고\n전해줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00076000:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "17,0170101",
        "face": "0,0,0",
        "voice": "GB310803,3"
      },
      "original": "了解しました。\n",
      "translation": "알겠습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00076000:dialogue:0012",
      "channel": 1,
      "context": {
        "face": "0,0,0",
        "voice": "GB310803,3",
        "speaker": "1,0010301"
      },
      "original": "紋章機は、全速で救援に向かってくれ。\n",
      "translation": "문장기는, 전속력으로 구원에 나서줘.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00076000:dialogue:0013",
      "channel": 1,
      "context": {
        "voice": "GB411209,3",
        "speaker": "107,1070103"
      },
      "original": "はい、タクトさん。\nこれ以上の不法行為は、許しません。\n",
      "translation": "네, 택트 씨. 이 이상의 불법 행위는,\n용서하지 않겠습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00076000:dialogue:0014",
      "channel": 1,
      "context": {
        "voice": "GB411209,3",
        "speaker": "1,0010301"
      },
      "original": "頼むぞ、ふたりとも。\n以上だ。\n",
      "translation": "부탁한다, 둘 다. 이상이다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00076000:dialogue:0015",
      "channel": 0,
      "context": {
        "voice": "GB411209,3",
        "speaker": "999,0"
      },
      "original": "～敵部隊の編成～\n　駆逐艦×６　　　　　　巡洋艦×４\n　\n～勝利条件～\n　民間船の目標地点到達\n　\n～敗北条件～\n　エルシオールの破壊\n　タイムオーバー\n",
      "translation": "～적 부대\n편성～구축함×６　　　　　　순양함×４～\n승리 조건～민간선의 목표 지점 도달～패배\n조건～에르시올의 파괴 타임 오버\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00076000:dialogue:0016",
      "channel": 1,
      "context": {
        "voice": "GB210409,3",
        "speaker": "7,0070101",
        "face": "0,0070101,0"
      },
      "original": "もう一度、作戦内容を確認するか？\n",
      "translation": "다시 한번, 작전 내용을 확인할까？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00076000:dialogue:0017",
      "channel": 1,
      "context": {
        "speaker": "1,0010401",
        "voice": "GB210409,3",
        "face": "0,0070101,0"
      },
      "original": "そうだなぁ……。\n",
      "translation": "글쎄...\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00076000:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "voice": "GB210409,3",
        "face": "0,0070101,0"
      },
      "original": "うん。\n念のため、もう一度確認しておこう。\n",
      "translation": "응. 만약을 위해, 다시 한번 확인해 두자.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00076000:dialogue:0019",
      "channel": 1,
      "context": {
        "speaker": "1,0010301",
        "voice": "GB210409,3",
        "face": "0,0,0"
      },
      "original": "いや、その必要はない。\nみんな、準備はいいな？\n",
      "translation": "아니, 그럴 필요는 없다. 모두, 준비는\n됐나？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00076000:dialogue:0020",
      "channel": 1,
      "context": {
        "speaker": "1,0010302",
        "voice": "GB210409,3",
        "face": "0,0,0"
      },
      "original": "エンジェル隊、出撃！\n",
      "translation": "엔젤대, 출격！\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_00076000:dialogue:0021",
      "channel": 1,
      "context": {
        "voice": "GB410610,3",
        "speaker": "998,0",
        "face": "0,0,0"
      },
      "original": "了解！\n",
      "translation": "알았다！\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
