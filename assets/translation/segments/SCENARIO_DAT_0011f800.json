{
  "schema": "galaxy-angel-translation-segment/v1",
  "source": {
    "path": "SCENARIO_DAT_0011f800.txt",
    "encoding": "cp932",
    "sha256": "2fa2a9ccb6b7bf3a5f0832edf9726fc5aece013b53c37eae228f558db609cc76",
    "dialogue_count": 39
  },
  "units": [
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0001",
      "channel": 1,
      "context": {
        "face": "0020902,0,0060304",
        "speaker": "1,0010201"
      },
      "original": "ガンガンいけば勝てるさ。\n気後れしてたら、勝てるものも勝てなくなる。\n",
      "translation": "거침없이 밀어붙이면 이길 수 있어.\n주춤하고 있으면, 이길 수 있는 것도 이길\n수 없게 돼.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0002",
      "channel": 1,
      "context": {
        "face": "0050102,0,0",
        "speaker": "5,0050101",
        "voice": "GB963100,3"
      },
      "original": "そういうこと。\n始まったら、敵に勝つことだけ考えりゃいい\nんだよ。\n",
      "translation": "바로 그거야. 시작되면 적을 이기는 것만\n생각하면 된다고.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0003",
      "channel": 1,
      "context": {
        "face": "0050102,0,0030804",
        "speaker": "3,0030101",
        "voice": "GB963101,3"
      },
      "original": "そうよ！\nやっぱ戦争は気合！\n恋愛とおんなじよ！\n",
      "translation": "맞아！ 역시 전쟁은 기합이야！ 연애랑\n똑같다고！\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0004",
      "channel": 1,
      "context": {
        "face": "0050804,0,0030804",
        "speaker": "5,0050101",
        "voice": "GB963102,3"
      },
      "original": "うーし、んじゃ景気づけに、今からパーッと\nやっか！？\n",
      "translation": "좋았어, 그럼 분위기 전환 겸 지금부터 확\n해치워버릴까！？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0005",
      "channel": 1,
      "context": {
        "face": "0050804,0,0030105",
        "speaker": "3,0030101",
        "voice": "GB963103,3"
      },
      "original": "あ、いいですねー、フォルテさん！\n",
      "translation": "아, 좋네요, 포르테 씨！\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0006",
      "channel": 1,
      "context": {
        "face": "0020902,0,0060304",
        "speaker": "1,0010401",
        "voice": "GB963103,3"
      },
      "original": "やっぱり、敵の出方にも注意が必要だ。\nあれだけの力を持っている敵だからな。\n",
      "translation": "역시 적의 움직임에도 주의가 필요하다. 그\n정도의 힘을 가진 적이니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0007",
      "channel": 1,
      "context": {
        "face": "0040701,0,0060304",
        "speaker": "4,0040101",
        "voice": "GB963104,3"
      },
      "original": "ええ、慎重に事を進めるに越したことはあり\nませんわ。\n",
      "translation": "네, 신중하게 일을 진행하는 것이 가장\n좋겠어요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0008",
      "channel": 1,
      "context": {
        "face": "1070103,0,0",
        "speaker": "107,1070101",
        "voice": "GB963105,3"
      },
      "original": "私も、そう思います。\n",
      "translation": "저도 그렇게 생각합니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0009",
      "channel": 1,
      "context": {
        "face": "1070103,0,0030102",
        "speaker": "3,0030101",
        "voice": "GB963106,3"
      },
      "original": "大丈夫だって。\nちとせは、まだ翼の生えた紋章機の力を知ら\nないから、心配なのよ。\n",
      "translation": "괜찮다니까. 치토세는 아직 날개가 돋아난\n문장기의 힘을 모르니까 걱정하는 거야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0010",
      "channel": 1,
      "context": {
        "face": "1070302,0,0030102",
        "voice": "GB963107,3",
        "speaker": "107,1070101"
      },
      "original": "お言葉ですが、ランファ先輩。\n敵の戦力は、決して侮ることはできません。\n",
      "translation": "말씀은 감사합니다만, 란파 선배. 적의\n전력은 결코 얕볼 수 없습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0011",
      "channel": 1,
      "context": {
        "speaker": "4,0040101",
        "face": "0040103,0,0",
        "voice": "GB963108,3"
      },
      "original": "そうですわよ。\nせっかく私たちには知恵というものがあるの\nですから、それを有効に使わないと。\n",
      "translation": "맞아요. 어렵사리 우리에게 지혜라는 것이\n있으니, 그것을 유효하게 사용해야죠.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0012",
      "channel": 1,
      "context": {
        "speaker": "3,0030101",
        "face": "0040103,0,0030104",
        "voice": "GB963109,3"
      },
      "original": "それ、アタシが頭使ってないって言いたいワ\nケ？\n",
      "translation": "그거, 내가 머리를 안 쓰고 있다는\n뜻이야？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0013",
      "channel": 1,
      "context": {
        "speaker": "5,0050101",
        "face": "0,0050204,0",
        "voice": "GB963110,3"
      },
      "original": "はいはい、ケンカしてどうすんだい。\n",
      "translation": "예이 예이, 싸워서 뭐 하겠나.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0014",
      "channel": 1,
      "context": {
        "face": "0,0050204,0",
        "voice": "GB963110,3",
        "speaker": "1,0010101"
      },
      "original": "まぁ、なんとかなるさ。\n",
      "translation": "뭐, 어떻게든 되겠지.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0015",
      "channel": 1,
      "context": {
        "face": "0020102,0,-1",
        "speaker": "2,0020101",
        "voice": "GB963111,3"
      },
      "original": "そうですよね。\n今までも、それでなんとかなってきましたも\nんね。\n",
      "translation": "그렇죠. 지금까지도 그걸로 어떻게든 되어\n왔으니까요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0016",
      "channel": 1,
      "context": {
        "face": "0,0030104,0",
        "voice": "GB963112,3",
        "speaker": "3,0030101"
      },
      "original": "気楽でいいわねぇ、アンタたちは。\n",
      "translation": "낙천적이라 좋겠네, 너희들은.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0017",
      "channel": 1,
      "context": {
        "face": "0,0,0060101",
        "voice": "GB963113,3",
        "speaker": "6,0060101"
      },
      "original": "人事を尽くして天命を待つ……という言葉も\nあります。\n",
      "translation": "인사궁구 천명……이라는 말도 있습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0018",
      "channel": 1,
      "context": {
        "speaker": "1,0010101",
        "face": "0,0,0060101",
        "voice": "GB963113,3"
      },
      "original": "そうそう。\nやるだけやったら、後はなんとかなることを\n信じるだけさ。\n",
      "translation": "맞아 맞아. 할 만큼 했다면, 그다음은\n어떻게든 될 거라고 믿는 것뿐이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0019",
      "channel": 1,
      "context": {
        "face": "1070102,0,0060101",
        "voice": "GB963114,3",
        "speaker": "107,1070101"
      },
      "original": "なるほど……これが歴戦の勇士のたどりつく\n境地というものなのでしょうか……。\n",
      "translation": "과연…… 이것이 역전의 용사가 도달하는\n경지라는 것일까요…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0020",
      "channel": 1,
      "context": {
        "face": "0020102,0,0050204",
        "voice": "GB963114,3",
        "speaker": "1,0010101"
      },
      "original": "よし、オレも買い物でもするか。\n",
      "translation": "좋아, 나도 쇼핑이라도 할까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0021",
      "channel": 1,
      "context": {
        "speaker": "2,0020101",
        "face": "0,0020902,0",
        "voice": "GB963200,3"
      },
      "original": "じゃあ、タクトさんも一緒に行きましょう。\n",
      "translation": "그럼, 택트 씨도 함께 가요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0022",
      "channel": 1,
      "context": {
        "voice": "GB963201,3",
        "speaker": "4,0040101",
        "face": "0040704,0,0"
      },
      "original": "男手があると、なにかと助かりますしね。\n",
      "translation": "남자 손이 있으면 여러모로 도움이\n되니까요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0023",
      "channel": 1,
      "context": {
        "face": "0040704,0,0",
        "voice": "GB963201,3",
        "speaker": "1,0010105"
      },
      "original": "……って、オレ、荷物持ち？\n",
      "translation": "……근데, 나, 짐꾼？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0024",
      "channel": 1,
      "context": {
        "speaker": "4,0040101",
        "face": "0040301,0,0",
        "voice": "GB963202,3"
      },
      "original": "あら、男性として当然の義務ですわよね？\n",
      "translation": "어머, 남성으로서 당연한 의무 아닌가요？\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0025",
      "channel": 1,
      "context": {
        "speaker": "2,0020101",
        "face": "0040301,0,0020102",
        "voice": "GB963203,3"
      },
      "original": "そうなんですか？\nありがとうございます、タクトさん。\n",
      "translation": "그런 건가요？ 고마워요, 택트 씨.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0026",
      "channel": 1,
      "context": {
        "speaker": "1,0010105",
        "face": "0040301,0,0020102",
        "voice": "GB963203,3"
      },
      "original": "あ、あはは……。\n",
      "translation": "아, 아하하…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0027",
      "channel": 1,
      "context": {
        "voice": "GB963203,3",
        "speaker": "1,0010101",
        "face": "0020102,0,0050204"
      },
      "original": "やっぱり、普段どおりにするのが一番さ。\n",
      "translation": "역시, 평소대로 하는 게 제일이야.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0028",
      "channel": 1,
      "context": {
        "face": "-1,0,0050101",
        "speaker": "5,0050101",
        "voice": "GB963204,3"
      },
      "original": "そういうこと。\nヘンに変わったことしたら、かえって疲れるっ\nてもんさ。\n",
      "translation": "그런 거지. 이상하게 행동하면 오히려\n피곤해질 뿐이라고.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0029",
      "channel": 1,
      "context": {
        "face": "0030105,0,0050101",
        "speaker": "3,0030101",
        "voice": "GB963205,3"
      },
      "original": "ですよねー。\n",
      "translation": "그렇죠～.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0030",
      "channel": 1,
      "context": {
        "face": "0030804,0,0050101",
        "speaker": "3,0030101",
        "voice": "GB963206,3"
      },
      "original": "そんじゃ、タクトの運勢も占ってあげるわ。\n",
      "translation": "그럼, 택트의 운세도 점쳐 줄게.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0031",
      "channel": 1,
      "context": {
        "face": "0030804,0,0050101",
        "speaker": "1,0010101",
        "voice": "GB963206,3"
      },
      "original": "そうだな、今度お願いするよ。\n",
      "translation": "그렇군, 다음에 부탁할게.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0032",
      "channel": 1,
      "context": {
        "face": "0020102,0,0050204",
        "voice": "GB963206,3",
        "speaker": "1,0010101"
      },
      "original": "みんなの手伝いをするべきだと思うな。\n決戦兵器の製造に限らず、いろいろと人手が\n必要なところもあるだろうから。\n",
      "translation": "모두의 일을 도와야 한다고 생각하네.\n결전병기 제조뿐만 아니라, 여러 가지로\n일손이 필요한 곳도 있을 테니까.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0033",
      "channel": 1,
      "context": {
        "speaker": "6,0060101",
        "face": "0060101,0,0",
        "voice": "GB963207,3"
      },
      "original": "はい……。\n",
      "translation": "네…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0034",
      "channel": 1,
      "context": {
        "face": "0060101,0,1070102",
        "voice": "GB963208,3",
        "speaker": "107,1070101"
      },
      "original": "やはり、そうですよね。\nクレータ班長に、何か手伝えることはないか\n聞いてみます。\n",
      "translation": "역시, 그렇군요. 크레타 반장님께, 뭐\n도와드릴 일은 없는지 물어볼게요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0035",
      "channel": 1,
      "context": {
        "face": "0060101,0,1070102",
        "voice": "GB963208,3",
        "speaker": "1,0010101"
      },
      "original": "ただ、働きすぎて、肝心なときに倒れちゃう、\nなんてことのないようにね。\n",
      "translation": "다만, 너무 무리해서서 정작 중요한 때에\n쓰러지는, 그런 일이 없도록 하게나.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0036",
      "channel": 1,
      "context": {
        "speaker": "6,0060101",
        "face": "0060101,0,1070102",
        "voice": "GB963209,3"
      },
      "original": "了解しました。\n",
      "translation": "알겠습니다.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0037",
      "channel": 1,
      "context": {
        "speaker": "107,1070101",
        "face": "0060101,0,1070205",
        "voice": "GB963210,3"
      },
      "original": "了解です。\n働きすぎないように、がんばります。\n",
      "translation": "알겠습니다. 너무 무리하지 않도록, 열심히\n할게요.\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0038",
      "channel": 1,
      "context": {
        "voice": "GB963211,3",
        "speaker": "3,0030101",
        "face": "0,0,0030104"
      },
      "original": "働きすぎないようにがんばるって、どういう\n意味よ……。\n",
      "translation": "너무 무리하지 않도록 열심히 하겠다니,\n그게 무슨 의미야…….\n",
      "state": "draft",
      "use_translation": true
    },
    {
      "id": "SCENARIO_DAT_0011f800:dialogue:0039",
      "channel": 1,
      "context": {
        "face": "0040101,0,0030104",
        "voice": "GB963212,3",
        "speaker": "4,0040101"
      },
      "original": "まあまあ。\nちとせさんらしくて、いいじゃありませんか。\n",
      "translation": "자자. 치토세 씨답고 좋지 않습니까.\n",
      "state": "draft",
      "use_translation": true
    }
  ]
}
