  "schema": "moonlit-lovers-manual-remaining-batch/v1",
  "entries": [
    {"id":"remaining:00324","translation":"택트 씨, 에너지 보급을 하게 해\n"},
    {"id":"remaining:03134","translation":"죄송합니다, 마이어스 사령관님.\n"},
    {"id":"remaining:03135","translation":"……앗, 마이어스 사령관님, 이쪽을\n"},
    {"id":"remaining:03136","translation":"보고 계신 건가요？\n"},
    {"id":"remaining:03137","translation":"첫 실전이지만 최선을 다해\n"},
    {"id":"remaining:03138","translation":"설마 이런 식으로 마이어스 사령관님을\n"},
    {"id":"remaining:03139","translation":"뵙게 될 줄은 몰랐습니다.\n"},
    {"id":"remaining:03140","translation":"황국의 영웅 아래서 싸울 수 있어 영광\n"},
    {"id":"remaining:03141","translation":"으로 생각합니다.\n"},
    {"id":"remaining:03142","translation":"마이어스 사령관님 이야기는 선배들께\n"},
    {"id":"remaining:03143","translation":"항상 듣고 있습니다.\n"},
    {"id":"remaining:03144","translation":"선배들도 빨리 마이어스 사령관님을 뵙\n"},
    {"id":"remaining:03145","translation":"고 싶다고 하셨습니다.\n"},
    {"id":"remaining:03146","translation":"마이어스 사령관님께서 지휘해 주신다\n"},
    {"id":"remaining:03147","translation":"면 안심하고 싸울 수 있습니다.\n"},
    {"id":"remaining:03148","translation":"여러 의문이 있으시겠지만\n"},
    {"id":"remaining:03149","translation":"우선 이 함대부터 제거하죠.\n"},
    {"id":"remaining:03150","translation":"마이어스 사령관님, 그쪽 상황은 어떻\n"},
    {"id":"remaining:03151","translation":"습니까？\n"},
    {"id":"remaining:03152","translation":"저도 엔젤대의 일원입니다.\n"},
    {"id":"remaining:03153","translation":"부디 사양 말고 명령해 주세요.\n"},
    {"id":"remaining:03154","translation":"마이어스 사령관님, 이다음엔 어떻게 하면\n"},
    {"id":"remaining:03155","translation":"될까요？\n"},
    {"id":"remaining:03156","translation":"드디어 출력이 올라오기 시작했습니다.\n"},
    {"id":"remaining:03157","translation":"마이어스 사령관님, 지시를！\n"},
    {"id":"remaining:03169","translation":"목표 공격을 시작합니다.\n"},
    {"id":"remaining:03170","translation":"아직 할 수 있습니다, 맡겨 주세요！\n"},
    {"id":"remaining:03192","translation":"목표 변경, 이쪽을 노리는 함선부터\n"},
    {"id":"remaining:03193","translation":"격파하겠습니다.\n"},
    {"id":"remaining:03199","translation":"……아, 마이어스 사령관님.\n"},
    {"id":"remaining:03200","translation":"저기, 무슨 일이신가요……？\n"},
    {"id":"remaining:03201","translation":"마이어스 사령관님, 저라면\n"},
    {"id":"remaining:03202","translation":"걱정하지 않으셔도 됩니다.\n"},
    {"id":"remaining:03203","translation":"저 적의 주모자는 반드시 붙잡아 보\n"},
    {"id":"remaining:03204","translation":"이겠습니다.\n"},
    {"id":"remaining:03205","translation":"기체 반응은 조금 둔한 것 같지만,\n"},
    {"id":"remaining:03206","translation":"지장은 없습니다.\n"},
    {"id":"remaining:03207","translation":"마이어스 사령관님, 계속 명령해 주세\n"},
    {"id":"remaining:03209","translation":"저도 엔젤대의 일원입니다.\n"},
    {"id":"remaining:03210","translation":"선배들의 짐이 되지 않겠습니다.\n"},
    {"id":"remaining:03211","translation":"더 힘내야 해.\n"},
    {"id":"remaining:03212","translation":"더, 더……！\n"},
    {"id":"remaining:03213","translation":"선배들은 평소처럼 싸우고 있\n"},
    {"id":"remaining:03214","translation":"는데 왜 저는…….\n"},
    {"id":"remaining:03215","translation":"이 정도 적은…….\n"},
    {"id":"remaining:03216","translation":"조금 컨디션이 나쁜 정도로……！\n"},
    {"id":"remaining:03217","translation":"출력이 올라가지 않아…….\n"},
    {"id":"remaining:03218","translation":"만약 저 때문에 지면……！\n"},
    {"id":"remaining:03219","translation":"선배들에게 지지 않도록 저도 힘내\n"},
    {"id":"remaining:03220","translation":"야…….\n"},
    {"id":"remaining:03221","translation":"우리는 항상 １００퍼센트의 힘을\n"},
    {"id":"remaining:03222","translation":"낼 수 있어야 하는데…….\n"},
    {"id":"remaining:03223","translation":"마이어스 사령관님, 죄송합니다.\n"},
    {"id":"remaining:03224","translation":"저 때문에 폐를 끼쳐서…….\n"},
    {"id":"remaining:03225","translation":"……한심하기 짝이 없습니다.\n"},
    {"id":"remaining:03226","translation":"기체조차 제대로 움직이지 못하다니…….\n"},
    {"id":"remaining:03231","translation":"노린 대로 맞았습니다.\n"},
    {"id":"remaining:03242","translation":"방금 걸 피하다니…… ６번기에 이런\n"},
    {"id":"remaining:03243","translation":"기동성이 있었다니.\n"},
    {"id":"remaining:03246","translation":"저기, 택트 씨…… 여러모로 걱\n"},
    {"id":"remaining:03247","translation":"정을 끼쳤습니다.\n"},
    {"id":"remaining:03248","translation":"이번에는 전투에서 도움이 못 됐던\n"},
    {"id":"remaining:03249","translation":"몫까지 힘내겠습니다！\n"},
    {"id":"remaining:03250","translation":"이상한 기분입니다…… 전투 중인데도\n"},
    {"id":"remaining:03251","translation":"이렇게 편안하다니.\n"},
    {"id":"remaining:03252","translation":"택트 씨가 말씀하신 대로 잘\n"},
    {"id":"remaining:03253","translation":"기분 전환한 것 같습니다.\n"},
    {"id":"remaining:03254","translation":"우후훗…… 앗, 죄송합니다.\n"},
    {"id":"remaining:03255","translation":"전투 중인데 생각나서 웃음이…….\n"},
    {"id":"remaining:03256","translation":"평소처럼 자연스럽게…….\n"},
    {"id":"remaining:03257","translation":"뭔가 알 것 같은 기분이 듭니다.\n"},
    {"id":"remaining:03258","translation":"「택트 씨」라고 부르는 건……\n"},
    {"id":"remaining:03259","translation":"아직 조금 부끄럽네요.\n"},
    {"id":"remaining:03260","translation":"지금이라면 눈을 감고도 맞힐 수 있을\n"},
    {"id":"remaining:03261","translation":"것 같습니다.\n"},
    {"id":"remaining:03262","translation":"샤프 슈터의 상태가 이렇게\n"},
    {"id":"remaining:03263","translation":"좋은 건 처음입니다.\n"},
    {"id":"remaining:03264","translation":"자, 빨리 여길 돌파하고 소풍\n"},
    {"id":"remaining:03265","translation":"을 계속하죠.\n"},
    {"id":"remaining:03266","translation":"오늘은 선배들과 택트 씨에게 조금 가까\n"},
    {"id":"remaining:03267","translation":"워진 것 같습니다.\n"},
    {"id":"remaining:03268","translation":"택트 씨와 선배들께 정말 감사\n"},
    {"id":"remaining:03269","translation":"하고 있습니다.\n"},
    {"id":"remaining:03270","translation":"삶은 달걀을 만들 때 소금이나 식초를 넣으\n"},
    {"id":"remaining:03271","translation":"면 껍질이 잘 깨지지 않아요.\n"},
    {"id":"remaining:03274","translation":"택트 씨, 이걸로 드디어 전원 집합이 됐\n"},
    {"id":"remaining:03275","translation":"네요.\n"},
    {"id":"remaining:03276","translation":"엔젤대 전원이 달려들면 어떤\n"},
    {"id":"remaining:03277","translation":"적도 두렵지 않습니다.\n"},
    {"id":"remaining:03278","translation":"이번에야말로 주모자를 붙잡죠.\n"},
    {"id":"remaining:03279","translation":"택트 씨, 잘 부탁드립니다.\n"},
    {"id":"remaining:03282","translation":"포르테 선배와 민트 선배와도 잘\n"},
    {"id":"remaining:03283","translation":"지내고 싶습니다.\n"},
    {"id":"remaining:03284","translation":"꿈만 같아요…… 저까지 포함해\n"},
    {"id":"remaining:03285","translation":"６기의 문장기가 한자리에 모이다니.\n"},
    {"id":"remaining:03290","translation":"선배의 움직임을 공부하겠습니\n"},
    {"id":"remaining:03291","translation":"다.\n"},
    {"id":"remaining:03293","translation":"저는 아직 미숙하지만 조금이라도 선배들\n"},
    {"id":"remaining:03294","translation":"에게 가까워지도록 노력하겠습니다.\n"},
    {"id":"remaining:03297","translation":"포르테 선배와 민트 선배께 지금의 저\n"},
    {"id":"remaining:03298","translation":"를 보여드리고 싶습니다.\n"},
    {"id":"remaining:03301","translation":"저게 『흑색 달』…… 이야기는 들었\n"},
    {"id":"remaining:03302","translation":"지만…….\n"},
    {"id":"remaining:03303","translation":"이건 마치 에오니아 전역의 재현\n"},
    {"id":"remaining:03304","translation":"어떻게 해서든 지금 『흑색 달』\n"},
    {"id":"remaining:03305","translation":"을 파괴해야 합니다.\n"},
    {"id":"remaining:03306","translation":"저, 아버지 몫까지 끝까지 싸우겠습니다.\n"},
    {"id":"remaining:03307","translation":"저 『흑색 달』이 무인 함대를 만들\n"},
    {"id":"remaining:03308","translation":"어내고 있었군요.\n"},
    {"id":"remaining:03309","translation":"무인함은 맡겨 주세요.\n"},
    {"id":"remaining:03310","translation":"택트 씨는 『흑색 달』을！\n"},
    {"id":"remaining:03315","translation":"이게 『발・파스크』의 함선……\n"},
    {"id":"remaining:03316","translation":"우리의 적이군요.\n"},
    {"id":"remaining:03317","translation":"이런 일이 벌어지다니…….\n"},
    {"id":"remaining:03318","translation":"택트 씨, 저 거대함을 깨뜨릴 방법은\n"},
    {"id":"remaining:03319","translation":"분명 찾을 수 있겠죠？\n"},
    {"id":"remaining:03320","translation":"이 선견대를 격파하고 거대함의 습격\n"},
    {"id":"remaining:03321","translation":"에 대비해야 합니다.\n"},
    {"id":"remaining:03322","translation":"ＥＤＥＮ 시대 사람들도 이런\n"},
    {"id":"remaining:03323","translation":"함대와 싸웠던 걸까요…….\n"},
    {"id":"remaining:03324","translation":"이 신형함, 역시 상당한 힘을 지니고\n"},
    {"id":"remaining:03325","translation":"있는 것 같네요.\n"},
    {"id":"remaining:03329","translation":"어떤 적이 와도 우리는 지지\n"},
    {"id":"remaining:03331","translation":"저도 최선을 다해 힘내겠습니다.\n"}
  ]
}
